{
  "id": "shelves",
  "title": "Bookshelf Reader",
  "description": "Each book on a photo of bookshelves boxed and its title read, in Hebrew and English.",
  "visibility": "listed",
  "stage": "Develop",
  "summary": {"mask": true},
  "results": {"measures": [{"title": "Books", "count": ["books"]}]},
  "icon": "web/icon.svg",
  "poster": "web/poster.jpg",
  "phases": [
    {
      "key": "find",
      "name": "Find books",
      "button": "#bs-find"
    },
    {
      "key": "read",
      "name": "Read titles",
      "button": "#bs-read"
    }
  ],
  "viewer": "image2d",
  "python": {
    "paths": [
      "algorithm/"
    ],
    "entry": "shelves",
    "packages": [
      "numpy",
      "scipy",
      "scikit-image",
      "lazy-loader",
      "packaging",
      "pillow",
      "pillow-heif"
    ],
    "wheels": []
  },
  "algorithms": {
    "list": "web/algorithms.json",
    "metrics": "web/algorithm_metrics.json"
  },
  "services": {
    "det": "https://cdn.jsdelivr.net/npm/@gutenye/ocr-models@1.4.2/assets/ch_PP-OCRv4_det_infer.onnx",
    "tessdata": "web/tessdata",
    "words": [
      "https://cdn.jsdelivr.net/gh/hermitdave/FrequencyWords@525f9b560de45753a5ea01069454e72e9aa541c6/content/2018/he/he_50k.txt",
      "web/words/names.txt"
    ]
  },
  "web": {
    "module": "web/shelves.js",
    "panels": "web/shelves.html",
    "style": "web/shelves.css",
    "offline": [
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort.wasm.min.mjs",
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort-wasm-simd-threaded.mjs",
      "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/ort-wasm-simd-threaded.wasm",
      "https://cdn.jsdelivr.net/npm/@gutenye/ocr-models@1.4.2/assets/ch_PP-OCRv4_det_infer.onnx",
      "https://cdn.jsdelivr.net/gh/hermitdave/FrequencyWords@525f9b560de45753a5ea01069454e72e9aa541c6/content/2018/he/he_50k.txt"
    ]
  },
  "root": "https://drive.google.com/drive/folders/10IrHmFgIdTlhwcZM0gGlfmw4TCM6_gwj",
  "files": {
    "from": [
      "drive"
    ],
    "accept": ".jpg,.jpeg,.png,.webp,.tif,.tiff,.bmp,.heic,.heif",
    "empty": "Load a photo of bookshelves (JPEG, PNG, WebP, TIFF or HEIC), then press Find books."
  },
  "channels": [
    {
      "name": "Red",
      "colour": "#ff0000",
      "shown": true,
      "about": "The photo's red. The three colours together are the photo as the camera took it."
    },
    {
      "name": "Green",
      "colour": "#00ff00",
      "shown": true,
      "about": "The photo's green. The three colours together are the photo as the camera took it."
    },
    {
      "name": "Blue",
      "colour": "#0000ff",
      "shown": true,
      "about": "The photo's blue. The three colours together are the photo as the camera took it."
    }
  ],
  "progress": {
    "install": "Installing numpy, scipy, scikit-image, Pillow, pillow-heif…",
    "load": "Loading the book finder…",
    "open": "Reading the photo…",
    "run": "Finding the books and reading their titles…"
  },
  "groundTruth": {
    "actions": "web/gt_actions.js",
    "ring": "#ff00ff"
  },
  "view": {
    "stretch": false,
    "hide": [
      "ruler",
      "grid",
      "channels"
    ]
  },
  "actions": [
    {"id": "right", "label": "Right", "keys": ["Enter", "NumpadEnter"], "kind": "press", "legend": false, "control": ".bs-item [data-do=\"right\"]", "when": ["tagging", "book", "!drawing"], "inField": ".bs-item", "ownControl": true},
    {"id": "back", "label": "Back", "keys": ["Alt+ArrowLeft"], "kind": "press", "legend": false, "control": ".bs-item [data-do=\"back\"]", "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"},
    {"id": "next", "label": "Next", "keys": ["Alt+ArrowRight"], "kind": "press", "legend": false, "control": ".bs-item [data-do=\"next\"]", "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"},
    {"id": "flip", "label": "Flip", "keys": ["Ctrl+ArrowUp"], "kind": "press", "legend": false, "control": ".bs-item [data-do=\"flip\"]", "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"},
    {"id": "wrong", "label": "Not a book", "keys": ["Ctrl+Backspace"], "hint": "Ctrl+Backspace", "kind": "press", "legend": false, "control": ".bs-item [data-do=\"wrong\"]", "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"},
    {"id": "down", "label": "Field down", "title": "Swap the field with the one below, or move the text selected there", "keys": ["Alt+ArrowDown"], "kind": "press", "legend": false, "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"},
    {"id": "up", "label": "Field up", "title": "Swap the field with the one above, or move the text selected there", "keys": ["Alt+ArrowUp"], "kind": "press", "legend": false, "when": ["tagging", "book", "!drawing"], "inField": ".bs-item"}
  ]
}
