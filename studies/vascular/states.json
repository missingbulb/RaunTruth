{
  "about": "The Vascular Measurements study's own elements in the shell's states (req/checks/shell-states, req/checks/spec-layout): each graft puts its tree under the shell's element `under`, after its child `after` or first, in the tree of dev/requirements/shell-states.json, whose rules they follow; its roots and paths open this study. `samples` names the module writing the image or z-stack its paths load; `differ` says where a shell element shows otherwise in this study. `counted` is its first step, Run algorithm, done.",
  "grafts": [
    {"under": "Processing", "after": "Algorithms", "tree": [
      {"name": "The model", "select": "#model-set", "req": "req/vascular/model/run",
        "children": [
          {"name": "Run algorithm", "select": "#vm-run", "control": true, "req": "req/vascular/model/run"},
          {"name": "Model's message", "select": "#model-msg", "req": "req/vascular/model/run"}
        ]
      }
    ]},
    {"under": "Ground Truth Tasks", "tree": [
      {"name": "The tasks", "select": "#vm-tasks", "req": "req/vascular/truth/tasks"},
      {"name": "Task tools", "select": "#task-tools", "req": "req/vascular/truth/order",
        "children": [
          {"name": "This junction's options", "select": "#task-menu", "req": "req/vascular/truth/tasks", "steady": "shows only for an area's current junction, and the first area of the walked stack holds none",
            "rule": [
              {"is": "hidden", "approval": "tentative"}
            ]
          },
          {"name": "Skip", "select": "#task-skip", "control": true, "req": "req/vascular/truth/order"}
        ]
      },
      {"name": "The area now", "select": "#task-now", "req": "req/vascular/truth/tasks",
        "children": [
          {"name": "Junctions' note", "select": "#junctions-note", "req": "req/vascular/truth/tasks"},
          {"name": "Widths' note", "select": "#widths-note", "req": "req/vascular/truth/widths", "steady": "says something only in the widths step, which no path reaches",
            "rule": [
              {"is": "hidden", "approval": "tentative"}
            ]
          },
          {"name": "The junction's stage", "select": "#task-stage", "req": "req/vascular/truth/tasks",
            "children": [
              {"name": "The junction's card", "select": "#task-card", "req": "req/vascular/truth/tasks"}
            ]
          },
          {"name": "Area is right", "select": "#area-ok", "control": true, "req": "req/vascular/truth/tasks"},
          {"name": "Drawing's note", "select": "#draw-note", "req": "req/vascular/model/correct", "steady": "says something only while a vessel is being drawn, which no path does",
            "rule": [
              {"is": "hidden", "approval": "tentative"}
            ]
          }
        ]
      }
    ]},
    {"under": "Summary", "tree": [
      {"name": "The model's numbers", "select": "#vm-summary", "req": "req/vascular/summary/metrics"},
      {"name": "What the model holds", "select": "#model-facts", "req": "req/vascular/model/run"}
    ]},
    {"under": "Image view", "after": "Minimap", "tree": [
      {"name": "Map of the areas", "select": "#gt-mini", "req": "req/vascular/truth/tasks",
        "rule": [
          {"when": {"makesTruth": [false]}, "is": "hidden", "req": "req/shell/annotate/choice"},
          {"when": {"counted": [false]}, "is": "hidden", "approval": "tentative", "about": "the walk has nothing to open before the study has run"}
        ],
        "children": [
          {"name": "The flattened stack", "select": "#gt-mini-image", "req": "req/vascular/truth/tasks"},
          {"name": "The areas", "select": "#gt-mini-areas", "req": "req/vascular/truth/tasks"}
        ]
      }
    ]},
    {"under": "Keys legend", "tree": [
      {"name": "Image alone's key", "select": "#key-image-alone", "made": "by the shell, from the study's actions", "control": true, "req": "req/vascular/truth/widths",
        "unwalked": "shows only in the widths look", "rule": [{"is": "hidden", "approval": "tentative"}]},
      {"name": "Model's key", "select": "#key-model", "made": "by the shell, from the study's actions", "control": true, "req": "req/vascular/model/view",
        "rule": [{"when": {"counted": [false]}, "is": "hidden", "approval": "tentative"}]},
      {"name": "Outlines' key", "select": "#key-outlines", "made": "by the shell, from the study's actions", "control": true, "req": "req/vascular/model/view",
        "rule": [{"when": {"counted": [false]}, "is": "hidden", "approval": "tentative"}]},
      {"name": "Side by side's key", "select": "#key-side", "made": "by the shell, from the study's actions", "control": true, "req": "req/vascular/model/view",
        "rule": [{"when": {"counted": [false]}, "is": "hidden", "approval": "tentative"}]}
    ]},
    {"under": "Main view", "after": "Tasks/Items switch", "tree": [
      {"name": "Back to image", "select": "#vm-focus", "control": true, "req": "req/vascular/truth/tasks",
        "about": "Back to image while an area is open, Back to task on the whole stack",
        "rule": [
          {"when": {"counted": [false]}, "is": "hidden"},
          {"when": {"makesTruth": [false]}, "is": "hidden", "about": "the tasks are only for those who make ground truth"}
        ]
      },
      {"name": "Show menu", "select": "#vm-show", "req": "req/vascular/model/view",
        "rule": [
          {"when": {"makesTruth": [true], "counted": [true]}, "is": "hidden", "about": "while an area is open Back to image takes its place"}
        ]
      }
    ]},
    {"under": "Main view", "after": "Image view", "tree": [
      {"name": "Item view", "select": "#items-view", "req": "req/shell/views/second",
        "rule": [
          {"when": {"view": ["image"]}, "is": "hidden"}
        ],
        "children": [
          {"name": "Junctions or vessels", "select": "#item-kind", "req": "req/vascular/model/cards"},
          {"name": "Which items", "select": "#item-filter", "control": true, "req": "req/vascular/model/cards"},
          {"name": "Order", "select": "#item-sort", "control": true, "req": "req/vascular/model/cards"},
          {"name": "Items' note", "select": "#items-note", "req": "req/vascular/model/cards"},
          {"name": "No items yet", "select": "#items-empty", "req": "req/vascular/model/cards", "steady": "shows only before Execute, when the item view cannot be opened",
            "rule": [
              {"is": "hidden"}
            ]
          },
          {"name": "Item cards", "select": "#item-list", "req": "req/vascular/model/cards"}
        ]
      }
    ]}
  ],
  "samples": "tests/state_samples.py",
  "differ": {
    "Save crumb": {"steady": "its Review step is still to do on every path",
      "rule": [
        {"is": "hidden", "approval": "tentative", "req": "req/shell/status-bar/breadcrumbs"}
      ]
    }
  },
  "roots": {
    "Public, signed out": {"stage": "Public", "signedIn": false},
    "Develop, Annotator": {"stage": "Develop", "signedIn": true, "maySave": true}
  },
  "paths": [
    {"root": "Public, signed out", "actions": ["load", "stack", "count", "items", "image"]},
    {"root": "Develop, Annotator", "actions": ["stack", "scratch", "count"]}
  ]
}
