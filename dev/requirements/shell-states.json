                    }
                  ]
                },
                {"name": "Download Summary", "select": "#summary-dl", "control": true, "req": "req/shell/summary/download",
                  "rule": [
                    {"is": "shown", "approval": "undecided"}
                  ]
                }
              ]
            }
          ]
        },
        {"name": "Left bar gutter", "select": "#gutter-left", "req": "req/shell/left-bar/width", "steady": "always shown"},
        {"name": "Main view", "select": "#view", "req": "req/shell/image/minimap", "steady": "always shown",
          "children": [
            {"name": "Tasks/Items switch", "select": "#switch", "control": true, "req": "req/shell/views/second",
              "rule": [
                {"when": {"itemView": [false]}, "is": "hidden"},
                {"when": {"makesTruth": [true]}, "is": "hidden"},
                {"when": {"role": ["data"]}, "is": "hidden", "req": "req/shell/data/mode"},
                {"when": {"counted": [false]}, "is": "disabled"}
              ]
            },
            {"name": "Ruler", "select": "#ruler-btn", "control": true, "req": "req/shell/tools/ruler",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"},
                {"when": {"image": ["none"]}, "is": "disabled", "req": "req/shell/image/minimap"}
              ]
            },
            {"name": "Grid", "select": "#grid-btn", "control": true, "req": "req/shell/tools/grid",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"},
                {"when": {"stack": [true], "shows3d": [true]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                {"when": {"image": ["none"]}, "is": "disabled", "req": "req/shell/image/minimap"}
              ]
            },
            {"name": "Minimap button", "select": "#minimap-btn", "control": true, "req": "req/shell/image/minimap",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"},
                {"when": {"stack": [true], "shows3d": [true]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                {"when": {"image": ["none"]}, "is": "disabled"}
              ]
            },
            {"name": "Reset view group", "select": "#v3-tools", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d",
              "rule": [
                {"when": {"shows3d": [false]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                {"when": {"stack": [false]}, "is": "hidden"}
              ],
              "children": [
                {"name": "Reset view to top", "select": "#v3-reset", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d"}
              ]
            },
            {"name": "Zoom out", "select": "#zoom-out", "control": true, "req": "req/shell/image/minimap",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"},
                {"when": {"image": ["none"]}, "is": "disabled"}
              ]
            },
            {"name": "Zoom in", "select": "#zoom-in", "control": true, "req": "req/shell/image/minimap",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"},
                {"when": {"image": ["none"]}, "is": "disabled"}
              ]
            },
            {"name": "Zoom", "select": "#zoom-label", "req": "req/shell/image/minimap",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden", "req": "req/shell/views/second"}
              ]
            },
            {"name": "Lasso hint", "select": "#lasso-hint", "req": "req/shell/summary/mask", "steady": "shows only while a mask is being lassoed, which no path does",
              "rule": [
                {"is": "hidden"}
              ]
            },
            {"name": "Busy", "select": "#busy", "req": "req/shell/waiting/visible", "unwalked": "shows only while the study works, and the walk reads the page once it has settled",
              "rule": [
                {"is": "hidden"}
              ],
              "children": [
                {"name": "Scan light", "select": "#scan-light", "req": "req/shell/waiting/visible"},
                {"name": "Busy's text", "select": "#busy-text", "req": "req/shell/waiting/visible"},
                {"name": "Busy's time", "select": "#busy-time", "req": "req/shell/waiting/visible"}
              ]
            },
            {"name": "Image view", "select": "#image-view", "req": "req/shell/views/second",
              "rule": [
                {"when": {"view": ["items"]}, "is": "hidden"},
                {"when": {"selected": ["folder"]}, "is": "hidden", "req": "req/shell/data/folder"}
              ],
              "children": [
                {"name": "Scroller", "select": "#scroller", "req": "req/shell/image/minimap",
                  "rule": [
                    {"when": {"stack": [true], "shows3d": [true]}, "is": "hidden", "req": "req/shell/viewer-3d"}
                  ],
                  "children": [
                    {"name": "Empty view's text", "select": "#empty", "req": "req/shell/image/minimap",
                      "rule": [
                        {"when": {"image": ["local", "preview", "original"]}, "is": "hidden"}
                      ],
                      "children": [
                        {"name": "Empty view's words", "select": "#empty-text", "req": "req/shell/image/minimap"}
                      ]
                    },
                    {"name": "Image", "select": "#stage", "req": "req/shell/image/minimap",
                      "rule": [
                        {"when": {"image": ["none"]}, "is": "hidden"}
                      ],
                      "children": [
                        {"name": "Image's canvas", "select": "#base", "req": "req/shell/image/minimap"},
                        {"name": "Image zoomed out", "select": "#shrunk", "req": "req/shell/image/scaling",
                          "rule": [{"when": {"imageLarge": [false]}, "is": "hidden"}]}
                      ]
                    }
                  ]
                },
                {"name": "3D view", "select": "#v3-stage", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d",
                  "rule": [
                    {"when": {"shows3d": [false]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                    {"when": {"stack": [false]}, "is": "hidden"}
                  ],
                  "children": [
                    {"name": "3D picture", "select": "#v3-gl", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d"},
                    {"name": "Drawn over the 3D view", "select": "#v3-hud", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d"}
                  ]
                },
                {"name": "Minimap", "select": "#minimap", "req": "req/shell/image/minimap",
                  "rule": [
                    {"when": {"image": ["none"]}, "is": "hidden"},
                    {"when": {"imageFits": [true]}, "is": "hidden"}
                  ],
                  "children": [
                    {"name": "Hide the minimap", "select": "#minimap-hide", "control": true, "req": "req/shell/image/minimap"},
                    {"name": "Fold the minimap", "select": "#minimap-fold", "control": true, "req": "req/shell/image/minimap"},
                    {"name": "Minimap's picture", "select": "#minimap-canvas", "req": "req/shell/image/minimap"},
                    {"name": "Minimap's view", "select": "#minimap-view", "req": "req/shell/image/minimap"}
                  ]
                },
                {"name": "Edit History", "select": "#edit-history", "req": "req/shell/ground-truth/history",
                  "rule": [
                    {"when": {"makesTruth": [false]}, "is": "hidden", "approval": "tentative", "about": "only a tagger has a log to show"},
                    {"when": {"counted": [false]}, "is": "hidden", "approval": "tentative", "about": "the log has no run yet"}
                  ],
                  "children": [
                    {"name": "Edit History's count", "select": "#eh-count", "req": "req/shell/ground-truth/history"},
                    {"name": "Hide Edit History", "select": "#eh-close", "control": true, "req": "req/shell/ground-truth/history"},
                    {"name": "Edit History's rows", "select": "#eh-list", "req": "req/shell/ground-truth/history"},
                    {"name": "Clear all history", "select": "#eh-clear", "control": true, "req": "req/shell/ground-truth/clear"}
                  ]
                },
                {"name": "Keys legend", "select": "#keys-legend", "made": "by the shell, as the page starts", "req": "req/shell/image/keys",
                  "children": [
                    {"name": "Panning", "select": "#v3-pan", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d",
                      "rule": [
                        {"when": {"shows3d": [false]}, "is": "hidden", "req": "req/shell/image/keys"},
                        {"when": {"stack": [false]}, "is": "hidden"}
                      ]}
                  ]
                }
              ]
            },
            {"name": "Folder view", "select": "#folder-view", "req": "req/shell/data/folder",
              "rule": [
                {"when": {"selected": ["nothing", "image"]}, "is": "hidden"}
              ],
              "children": [
                {"name": "Folder's title", "select": "#folder-title", "req": "req/shell/data/folder"},
                {"name": "Grid or list", "select": "#folder-layout", "req": "req/shell/data/folder"},
                {"name": "Folder's images", "select": "#folder-items", "req": "req/shell/data/folder"}
              ]
            }
          ]
        }
      ]
    },
    {"name": "Status bar", "select": "#statusbar", "req": "req/shell/status-bar", "steady": "always shown",
      "children": [
        {"name": "Breadcrumbs", "select": "#sb-steps", "req": "req/shell/status-bar/breadcrumbs",
          "rule": [
            {"when": {"role": ["data"]}, "is": "hidden", "req": "req/shell/data/mode"}
          ],
          "children": [
            {"name": "Submit GT crumb", "select": "#sb-submit", "made": "one crumb per step, by the shell", "req": "req/shell/status-bar/breadcrumbs",
              "rule": [
                {"when": {"makesTruth": [false]}, "is": "hidden"},
                {"when": {"counted": [false]}, "is": "hidden"}
              ]
            }
          ]
        },
        {"name": "Now", "select": "#sb-now", "req": "req/shell/status-bar", "steady": "always shown",
          "children": [
            {"name": "Spinner", "select": "#spin", "req": "req/shell/waiting/visible", "steady": "turns only while something loads, never once the page has settled",
              "rule": [
                {"is": "hidden"}
              ]
            },
            {"name": "Status", "select": "#status", "req": "req/shell/status-bar", "steady": "always shown"}
          ]
        },
        {"name": "Resources", "select": "#sb-res", "req": "req/shell/status-bar/resources", "steady": "always shown",
          "children": [
            {"name": "Resources, unfolded", "select": "#sb-res-items", "req": "req/shell/status-bar/resources", "steady": "always shown",
              "children": [
                {"name": "Storage", "select": "#sb-disk", "control": true, "req": "req/shell/status-bar/disk", "steady": "always shown"},
                {"name": "Memory", "select": "#sb-memory", "control": true, "req": "req/shell/status-bar/memory", "steady": "always shown"},
                {"name": "Network", "select": "#sb-net", "control": true, "req": "req/shell/status-bar/network", "steady": "always shown"},
                {"name": "CPU", "select": "#sb-cpu", "control": true, "req": "req/shell/status-bar/cpu", "steady": "always shown"}
              ]
            },
            {"name": "Resources icon", "select": "#sb-res-icon", "control": true, "req": "req/shell/status-bar/resources", "steady": "always shown"}
          ]
        },
        {"name": "Online icon", "select": "#sb-online", "control": true, "req": "req/shell/status-bar/online", "steady": "always shown, its icon what the connection is"},
        {"name": "Report a problem", "select": "#sb-report", "control": true, "req": "req/shell/report/bug",
          "rule": [
            {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default"}
          ]
        },
        {"name": "Version", "select": "#sb-version", "control": true, "req": "req/shell/version-history", "steady": "always shown"},
        {"name": "What's new", "select": "#whats-new", "req": "req/shell/version-history", "unwalked": "pops up only for a version the user has not seen",
          "rule": [
            {"is": "hidden"}
          ],
          "children": [
            {"name": "What's new, open", "select": "#whats-new-open", "control": true, "req": "req/shell/version-history"},
            {"name": "What's new, close", "select": "#whats-new-x", "control": true, "req": "req/shell/version-history"}
          ]
        }
      ]
    },
    {"name": "Tooltip", "select": "#tip", "req": "req/shell/channels/rows", "steady": "shows only on hover",
      "rule": [
        {"is": "hidden"}
      ]
    },
    {"name": "Icons", "select": "#icons", "req": "req/shell/header", "steady": "the page's icons to copy from, never shown",
      "rule": [
        {"is": "hidden"}
      ]
    },
    {"name": "Notice", "select": "#notice", "req": "req/shell/ground-truth/submit",
      "rule": [
        {"when": {"notice": [false]}, "is": "hidden", "approval": "tentative"}
      ],
      "children": [
        {"name": "Notice's text", "select": "#notice-text", "req": "req/shell/ground-truth/submit"},
        {"name": "OK", "select": "#notice-ok", "control": true, "req": "req/shell/ground-truth/submit"}
      ]
    }
  ]
}
