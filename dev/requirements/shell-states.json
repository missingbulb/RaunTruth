{
  "about": "The shell's elements, as a tree, and what each shows in every state the paths below reach (req/checks/shell-states). An element says only how it differs from its parent: its rule is a list of cases, the first whose `when` matches the state deciding, and an element with no rule shows as its parent does. A case is `owner` (the spec says so) unless it says `tentative` (Claude's call, not approved) or `undecided` (nobody has decided: not checked). The paths below open the study `study` names, the shell's test study, with its states.json grafted in; each other study's states.json may add paths of its own, opening it. dev/tools/build/shell_states.py turns this file, and every study's states.json, into the matrix and the browser test's expectations.",
  "study": "fixture",
  "vars": {
    "stage": [null, "PreGT", "GT", "PostGT", "Published"],
    "signedIn": [false, true],
    "role": ["viewer", "tagger", "data"],
    "image": ["none", "local", "preview", "original"],
    "counted": [false, true],
    "view": ["image", "items"],
    "selected": ["nothing", "folder", "image"],
    "online": [true, false],
    "stack": [false, true],
    "fromComputer": [false, true],
    "hasSteps": [false, true],
    "itemView": [false, true],
    "notice": [false, true],
    "imageFits": [true, false],
    "imageLarge": [false, true],
    "shows3d": [false, true],
    "masks": [false, true]
  },
  "roots": {
    "GT, signed out": {"stage": "GT", "signedIn": false, "role": "viewer"},
    "GT, Viewer": {"stage": "GT", "signedIn": true, "role": "viewer"},
    "GT, Tagger": {"stage": "GT", "signedIn": true, "role": "tagger"},
    "PostGT, Tagger": {"stage": "PostGT", "signedIn": true, "role": "tagger"},
    "PreGT, signed out": {"stage": "PreGT", "signedIn": false, "role": "viewer"},
    "PreGT, Tagger": {"stage": "PreGT", "signedIn": true, "role": "tagger"},
    "Published, Viewer": {"stage": "Published", "signedIn": true, "role": "viewer"},
    "GT, Study Manager": {"stage": "GT", "signedIn": true, "role": "data"},
    "PreGT, Study Manager": {"stage": "PreGT", "signedIn": true, "role": "data"}
  },
  "paths": [
    {"root": "GT, signed out", "actions": ["load", "count", "items"]},
    {"root": "GT, Viewer", "actions": ["load", "tagger"]},
    {"root": "GT, Tagger", "actions": ["load", "count"]},
    {"root": "PostGT, Tagger", "actions": ["load", "count"]},
    {"root": "PreGT, signed out", "actions": ["load", "count"]},
    {"root": "PreGT, Tagger", "actions": ["load", "count", "items"]},
    {"root": "Published, Viewer", "actions": ["load", "count", "items"]},
    {"root": "GT, Tagger", "actions": ["load", "offline", "online"]},
    {"root": "GT, Study Manager", "actions": ["folder", "preview", "original", "offline"]},
    {"root": "GT, Study Manager", "actions": ["folder", "offline", "online"]},
    {"root": "GT, Study Manager", "actions": ["folder", "zpreview", "original"]},
    {"root": "PreGT, Study Manager", "actions": ["folder"]},
    {"root": "GT, Tagger", "actions": ["load", "ok", "count", "unload"]},
    {"root": "GT, Tagger", "actions": ["load", "count", "viewer"]},
    {"root": "GT, Tagger", "actions": ["load", "count", "restudy"]},
    {"root": "GT, Tagger", "actions": ["drive", "count"]},
    {"root": "GT, Study Manager", "actions": ["viewer", "load", "data"]},
    {"root": "GT, Viewer", "actions": ["load", "zoom"]},
    {"root": "GT, Viewer", "actions": ["large"]}
  ],
  "tree": [
    {"name": "Header", "select": "header", "req": "req/shell/header", "steady": "always shown",
      "children": [
        {"name": "Logo", "select": "#logo", "req": "req/shell/header", "steady": "always shown"},
        {"name": "Study switcher", "select": "#study-menu", "req": "req/shell/header", "steady": "always shown",
          "children": [
            {"name": "Study's icon", "select": "#title-icon", "req": "req/shell/header", "steady": "always shown"},
            {"name": "Study's name", "select": "#title", "req": "req/shell/header", "steady": "always shown"}
          ]
        },
        {"name": "Dark/light switch", "select": "#theme", "control": true, "req": "req/shell/header", "steady": "always shown"},
        {"name": "Role menu", "select": "#role-menu", "req": "req/shell/account/role", "steady": "always shown, its choices what the user may take",
          "children": [
            {"name": "Role's name", "select": "#role-name", "req": "req/shell/account/role", "steady": "always shown"}
          ]
        },
        {"name": "You (the user menu)", "select": "#user-menu", "req": "req/shell/account/sign-in", "steady": "always shown, signed in or not"}
      ]
    },
    {"name": "Layout", "select": "#layout", "req": "req/shell/left-bar/width", "steady": "always shown",
      "children": [
        {"name": "Data Management column", "select": "#data-col", "req": "req/shell/data/mode",
