                  "children": [
                    {"name": "Image selector", "select": "#image-menu", "req": "req/shell/load/selector",
                      "children": [
                        {"name": "Selector's face", "select": "#image-pick", "req": "req/shell/load/selector"}
                      ]
                    },
                    {"name": "This computer", "select": "#load-main", "control": true, "req": "req/shell/load/from",
                      "rule": [
                        {"when": {"fromComputer": [false]}, "is": "hidden"}
                      ]
                    },
                    {"name": "Unload", "select": "#unload", "control": true, "req": "req/shell/load/selector",
                      "rule": [
                        {"when": {"image": ["none"]}, "is": "hidden"}
                      ]
                    },
                    {"name": "Google Drive button", "select": "#load-remote", "control": true, "req": "req/shell/load/selector"}
