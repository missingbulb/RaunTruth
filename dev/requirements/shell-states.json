              "children": [
                {"name": "Ground truth offer", "select": "#gt-offer", "req": "req/shell/ground-truth/view"},
                {"name": "Load GT tagging", "select": "#load-gt", "control": true, "req": "req/shell/ground-truth/view"},
                {"name": "Ground truth summary", "select": "#gt-summary", "req": "req/shell/ground-truth/view"}
              ]
            },
            {"name": "Selected Folder", "select": "#folder-box", "box": true, "req": "req/shell/data/folder",
              "rule": [
                {"when": {"selected": ["nothing", "image"]}, "is": "hidden"},
                {"when": {"online": [false]}, "is": "held", "req": "req/shell/data/mode"}
              ],
              "children": [
                {"name": "Folder's name", "select": "#folder-name", "req": "req/shell/data/folder"},
                {"name": "Folder's sums", "select": "#folder-summary", "req": "req/shell/data/folder"},
                {"name": "Update previews", "select": "#update-previews", "control": true, "req": "req/shell/data/update-previews",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default"}
