            {"when": {"role": ["viewer", "tagger"]}, "is": "hidden"},
            {"when": {"online": [false]}, "is": "held"}
          ],
          "children": [
            {"name": "Fold the folders", "select": "#data-open", "control": true, "req": "req/shell/data/mode"},
            {"name": "Folders", "select": "#data-body", "req": "req/shell/data/mode",
              "children": [
                {"name": "Set up ground truth", "select": "#gt-setup", "control": true, "req": "req/shell/ground-truth/setup",
                  "steady": "shows only while the study's root names no ground-truth folders, never in the fixture, which is set up",
                  "rule": [
                    {"is": "hidden", "approval": "tentative"}
                  ]
                },
                {"name": "Ground Truth box", "select": "#gt-box", "req": "req/shell/ground-truth/summary",
                  "rule": [
                    {"when": {"stage": [null, "PreGT", "Published"]}, "is": "hidden", "approval": "tentative"}
                  ],
                  "children": [
                    {"name": "Ground Truth box's title", "select": "#gt-box-title", "req": "req/shell/ground-truth/summary"},
                    {"name": "How the study takes ground truth", "select": "#gt-mode", "req": "req/shell/ground-truth/summary"},
                    {"name": "Ground truth counts", "select": "#gt-counts", "req": "req/shell/ground-truth/summary"},
                    {"name": "Switch reviewed or unreviewed", "select": "#gt-switch", "control": true, "req": "req/shell/ground-truth/switch",
                      "rule": [
                        {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                      ]
                    }
                  ]
                },
                {"name": "Approve folders", "select": "#data-approve", "control": true, "req": "req/shell/data/drive-access",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default"}
                  ]
                },
                {"name": "Folder tree", "select": "#data-tree", "req": "req/shell/data/mode"},
                {"name": "Not in the study", "select": "#data-unlisted", "req": "req/shell/data/folders", "unwalked": "shows only while the study's root holds a folder no listed folder is, and the walked study lists its root",
                  "rule": [
                    {"is": "hidden", "approval": "tentative"}
                  ],
                  "children": [
                    {"name": "Not in the study's title", "select": "#data-unlisted-title", "req": "req/shell/data/folders"},
                    {"name": "The root's other folders", "select": "#data-unlisted-list", "req": "req/shell/data/folders"}
                  ]
                },
                {"name": "Add a folder", "select": "#data-add-row", "req": "req/shell/data/folders",
                  "children": [
                    {"name": "Folder link to add", "select": "#data-add-link", "control": true, "req": "req/shell/data/folders",
                      "rule": [
                        {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                      ]
                    },
                    {"name": "Add folder", "select": "#data-add", "control": true, "req": "req/shell/data/folders",
                      "rule": [
                        {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                      ]
                    }
                  ]
                },
                {"name": "Tree's message", "select": "#data-msg", "req": "req/shell/data/mode"},
                {"name": "Study index's line", "select": "#data-index", "req": "req/shell/data/index"},
                {"name": "Study images", "select": "#study-set", "req": "req/shell/data/hidden",
                  "children": [
                    {"name": "Study images' title", "select": "#study-set-title", "req": "req/shell/data/hidden"},
                    {"name": "Group Load by", "select": "#study-group", "control": true, "req": "req/shell/load/study-images",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                  ]
                    },
                    {"name": "Hidden tags", "select": "#study-hide-list", "req": "req/shell/data/hidden"},
                    {"name": "Tag to hide", "select": "#study-hide-add", "control": true, "req": "req/shell/data/hidden",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                  ]
                    },
                    {"name": "Hide", "select": "#study-hide-go", "control": true, "req": "req/shell/data/hidden",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                  ]
                    },
                    {"name": "How many are hidden", "select": "#study-hide-count", "req": "req/shell/data/hidden"},
                    {"name": "Study images' message", "select": "#study-msg", "req": "req/shell/data/hidden"}
                  ]
                }
              ]
            }
          ]
        },
        {"name": "Left bar", "select": "#left", "req": "req/shell/left-bar/folding", "steady": "always shown",
          "children": [
            {"name": "Image box", "select": "#image-box", "box": true, "req": "req/shell/left-bar/folding",
              "rule": [
                {"when": {"selected": ["folder"]}, "is": "hidden", "req": "req/shell/data/folder"},
                {"when": {"hasSteps": [false]}, "is": "shown"},
                {"when": {"image": ["local", "original"]}, "is": "folded"}
              ],
              "children": [
                {"name": "File name and info", "select": "#file-box", "req": "req/shell/image/file-info",
                  "rule": [
                    {"when": {"image": ["none"]}, "is": "hidden"}
                  ],
                  "children": [
                    {"name": "Image's name", "select": "#file-name", "req": "req/shell/image/file-info"},
                    {"name": "Image's details", "select": "#file-info", "req": "req/shell/image/file-info", "steady": "opens only from the file's name",
                      "rule": [
                        {"is": "hidden"}
                      ]
                    }
                  ]
                },
                {"name": "Channels", "select": "#channels", "req": "req/shell/channels/rows",
                  "rule": [
                    {"when": {"image": ["none"]}, "is": "hidden"}
                  ],
                  "children": [
                    {"name": "Channel row", "select": "#channels .channel", "req": "req/shell/channels/rows",
                      "children": [
                        {"name": "Show/hide checkbox", "select": "#channels .channel input[type=checkbox]", "control": true, "req": "req/shell/channels/rows"},
                        {"name": "Black and white points", "select": "#channels .channel .levels", "req": "req/shell/channels/rows"},
                        {"name": "Colour picker", "select": "#channels .channel input[type=color]", "control": true, "req": "req/shell/channels/rows"}
                      ]
                    },
                    {"name": "Depth row", "select": "#channels .v3-slices", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d",
                      "rule": [
                        {"when": {"shows3d": [false]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                        {"when": {"stack": [false]}, "is": "hidden"}
                      ],
                      "children": [
                        {"name": "First slice shown", "select": "#v3-z0", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d"},
                        {"name": "Last slice shown", "select": "#v3-z1", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d"},
                        {"name": "Spacing between slices", "select": "#v3-zs", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d"}
                      ]
                    },
                    {"name": "Channel's Colour by depth", "select": "#channels .v3-tick", "made": "by the 3D view, once a stack opens", "req": "req/shell/viewer-3d",
                      "rule": [
                        {"when": {"shows3d": [false]}, "is": "hidden", "req": "req/shell/viewer-3d"},
                        {"when": {"stack": [false]}, "is": "hidden"}
                      ],
                      "children": [
                        {"name": "Colour by depth tick", "select": "#channels .v3-tick", "made": "by the 3D view, once a stack opens", "control": true, "req": "req/shell/viewer-3d"}
                      ]
                    }
                  ]
                },
                {"name": "Load", "select": "#load", "req": "req/shell/load/selector",
