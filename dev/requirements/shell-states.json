                {"name": "Folder's message", "select": "#folder-msg", "req": "req/shell/data/folder"}
              ]
            },
            {"name": "Tags", "select": "#tags-box", "box": true, "req": "req/shell/data/tags",
              "rule": [
                {"when": {"role": ["viewer", "tagger"]}, "is": "hidden", "req": "req/shell/data/mode"},
