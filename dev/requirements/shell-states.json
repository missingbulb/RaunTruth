                  ]
                }
              ]
            },
            {"name": "Ground Truth Tasks", "select": "#tasks-box", "box": true, "req": "req/shell/left-bar/shells",
              "rule": [
                {"when": {"hasSteps": [false]}, "is": "hidden", "approval": "tentative"},
                {"when": {"makesTruth": [false]}, "is": "hidden"},
