                  "children": [
                    {"name": "Load Original", "select": "#load-original", "control": true, "req": "req/shell/data/preview-images"},
                    {"name": "File chooser", "select": "#file", "control": true, "req": "req/shell/load/from", "steady": "the input behind This computer, never shown itself",
                      "rule": [
                        {"is": "hidden"}
                      ]
                    }
                  ]
                }
              ]
            },
            {"name": "Ground truth box", "select": "#truth-box", "box": true, "req": "req/shell/ground-truth/view", "unwalked": "shows only for a study whose ground truth is made, and the stand-in Drive holds none",
