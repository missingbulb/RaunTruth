                  "children": [
                    {"name": "Description's text", "select": "#tags-desc", "control": true, "req": "req/shell/data/tags",
                  "rule": [
                    {"when": {"online": [false]}, "is": "held", "req": "req/shell/offline/default", "approval": "tentative"}
                  ]
