__pycache__/
*.pyc

# the page's libraries for the tests that run them under Node (python3 web-tests/page_libraries.py)
/web-tests/node_modules
/web-tests/package*.json
# the page's vendored wheels (python3 dev/tools/build/build.py)
/web/vendor/
# the version history the page reads, built from main's history and web/version_history.md (python3 dev/tools/build/version_history.py json)
/web/version_history.json
# the studies the header's switcher offers (python3 dev/tools/build/build.py)
/web/studies.json
/web/literature.json
# the site the build assembles for the release beside the files tracked there (python3 dev/tools/build/build.py)
/dev/build/site/*
!/dev/build/site/analytics.js
